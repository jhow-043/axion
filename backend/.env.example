# ──────────────────────────────────────────────────
# Banco de dados (PostgreSQL async)
# ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/manutencao

# ──────────────────────────────────────────────────
# Segurança — NUNCA comitar valores reais (INV-05)
# ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars

# ──────────────────────────────────────────────────
# Aplicação
# ──────────────────────────────────────────────────
APP_NAME=Manutenção
DEBUG=false
LOG_LEVEL=INFO

# Origens CORS permitidas (JSON array)
CORS_ORIGINS=["http://localhost:5173"]

# ──────────────────────────────────────────────────
# Celery / Redis
# ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ──────────────────────────────────────────────────
# MinIO (armazenamento de arquivos)
# ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=manutencao
MINIO_SECURE=false

# ──────────────────────────────────────────────────
# E-mail (SMTP)
# ──────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@manutencao.local
